{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: create venv + install deps",
      "type": "shell",
      "command": "python -m venv .venv && . .venv/bin/activate && pip install -r backend/requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "backend: run",
      "type": "shell",
      "command": ". .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Uvicorn running",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "frontend: install deps",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "frontend: run",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0 --port 5173",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "app: run full stack",
      "dependsOn": [
        "backend: run",
        "frontend: run"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "docker: up",
      "type": "shell",
      "command": "docker compose up --build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
