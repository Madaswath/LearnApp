# Lumina AI – Environment Variables
# Copy this file to .env and fill in values

# OpenAI (optional – used if you want real LLM responses)
OPENAI_API_KEY=your_openai_api_key_here

# Groq (optional – alternative LLM provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# SQLite3 database file path (relative to backend/ or absolute)
# Default: storage/lumina.db
DB_PATH=storage/lumina.db

# CORS – comma-separated list of allowed origins (defaults to * in dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to "true" to enable debug/reload mode
DEBUG=false
